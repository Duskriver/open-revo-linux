{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [{
      "title": "OpenRevo for Linux",
      "label": "main",
      "width": 1080,
      "height": 760,
      "minWidth": 720,
      "minHeight": 540,
      "resizable": true,
      "decorations": true,
      "transparent": false,
      "center": true,
      "visible": true
    }]
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "category": "Utility",
    "shortDescription": "OpenRevo Linux laptop control center",
    "linux": {"deb": {"depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]}}
  }
}
