#!/bin/sh
set -eu

case "${1:-}" in
    remove|upgrade|deconfigure)
        status=$(dkms status -m openrevo-ec -v '@VERSION@')
        if [ -n "$status" ]; then
            # Only unregister this package's exact version. Never force unload.
            dkms remove -m openrevo-ec -v '@VERSION@' --all
        fi
        ;;
esac
exit 0
