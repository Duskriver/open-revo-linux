#!/bin/sh
set -eu

case "${1:-}" in
    remove|upgrade|deconfigure)
        # DKMS removes only this registered version; it does not force rmmod.
        status=$(dkms status -m openrevo-ec -v '@VERSION@')
        if [ -n "$status" ]; then
            dkms remove -m openrevo-ec -v '@VERSION@' --all
        fi
        ;;
esac
exit 0
